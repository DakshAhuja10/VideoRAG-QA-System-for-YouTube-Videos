# ============================================================
# LexiChat — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# NEVER commit .env to git — it is gitignored.
# ============================================================


# ── Required ─────────────────────────────────────────────────

# Google API key — used for Gemini 2.5 Flash (MultiQuery LLM)
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API key — used for answer generation, evaluation, and ground truth LLMs
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here


# ── Optional: Local Piper TTS (leave empty to use gTTS instead) ──
#
# Piper provides high-quality offline TTS on local machines.
# If any of these three paths is empty or missing, the system
# automatically falls back to gTTS (requires internet).
#
# Download Piper:        https://github.com/rhasspy/piper/releases
# Download voice model:  https://huggingface.co/rhasspy/piper-voices
# Download FFmpeg:       https://www.gyan.dev/ffmpeg/builds/

# Full path to the piper executable
PIPER_EXE=

# Full path to the .onnx voice model file
PIPER_VOICE=

# Full path to the ffmpeg executable (needed to convert WAV → MP3)
FFMPEG_EXE=
